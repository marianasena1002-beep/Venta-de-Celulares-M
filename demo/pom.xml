<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- =====================================================
         SPRING BOOT
         ===================================================== -->

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>


    <!-- =====================================================
         INFORMACIÓN DEL PROYECTO
         ===================================================== -->

    <groupId>com.examplegaes</groupId>

    <artifactId>demo</artifactId>

    <version>0.0.1-SNAPSHOT</version>

    <name>Venta Celulares</name>

    <description>
        Sistema de gestión y venta de celulares
    </description>


    <!-- =====================================================
         CONFIGURACIÓN DE JAVA
         ===================================================== -->

    <properties>

        <java.version>20</java.version>

    </properties>


    <!-- =====================================================
         DEPENDENCIAS
         ===================================================== -->

    <dependencies>


        <!-- =================================================
             SPRING WEB
             Para Controller, GetMapping, PostMapping,
             RequestParam, etc.
             ================================================= -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-web</artifactId>

        </dependency>


        <!-- =================================================
             THYMELEAF
             Para utilizar los archivos HTML dentro de
             src/main/resources/templates
             ================================================= -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-thymeleaf</artifactId>

        </dependency>


        <!-- =================================================
             SPRING DATA JPA
             Para conectar las entidades con MySQL
             ================================================= -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-data-jpa</artifactId>

        </dependency>


        <!-- =================================================
             MYSQL
             ================================================= -->

        <dependency>

            <groupId>com.mysql</groupId>

            <artifactId>mysql-connector-j</artifactId>

            <scope>runtime</scope>

        </dependency>


        <!-- =================================================
             VALIDACIÓN
             ================================================= -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-validation</artifactId>

        </dependency>


        <!-- =================================================
             TEST
             ================================================= -->

        <dependency>

            <groupId>org.springframework.boot</groupId>

            <artifactId>spring-boot-starter-test</artifactId>

            <scope>test</scope>

        </dependency>

    </dependencies>


    <!-- =====================================================
         BUILD
         ===================================================== -->

    <build>

        <plugins>

            <plugin>

                <groupId>org.springframework.boot</groupId>

                <artifactId>spring-boot-maven-plugin</artifactId>

            </plugin>

        </plugins>

    </build>


</project>